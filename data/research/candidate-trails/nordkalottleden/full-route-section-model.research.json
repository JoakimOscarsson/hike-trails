  "conclusion": "A source-backed full-route model is now drafted for Nordkalottleden/Nordkalottruta/Kalottireitti. The preferred app framing should be a Kautokeino-to-Sulitjelma mainline, with a separate Kvikkjokk-to-Sulitjelma southern variant route group. The existing 12-section Reisa/Kasivarsi packet covers only the northern Kautokeino-Kilpisjarvi sector and must be reversed if used in the full-trail direction.",
  "routeGroupPolicy": {
    "preferredMainline": {
      "id": "nordkalottleden-kautokeino-sulitjelma-mainline",
      "direction": "Kautokeino / Guovdageaidnu to Sulitjelma / Sulidalbma",
      "status": "preferred-full-route-model",
      "rationale": [
        "Reisa National Park describes the 800 km route as running from Sulitjelma to Kautokeino.",
        "Laponia describes the Arctic Trail as starting at Guovdageaidnu/Kautokeino and ending in Sulidalbma/Sulitjelma and Huhttan/Kvikkjokk.",
        "E1 Hiking Europe also frames Kautokeino-to-Sulitjelma as the route direction, but its stage table is only E1-scoped and must not be treated as the complete official inventory."
      ]
    },
    "southernVariant": {
      "id": "nordkalottleden-kvikkjokk-sulitjelma-variant",
      "direction": "Kvikkjokk / Huhttan to Sulitjelma / Sulidalbma",
      "status": "source-backed-alternate-route-group",
      "rationale": [
        "Laponia lists Huhttan/Kvikkjokk alongside Sulidalbma/Sulitjelma as southern endpoint framing.",
        "Battrafik i Kvikkjokk describes a Kvikkjokk-Sulitjelma section that follows Padjelantaleden to Tarrekaise, then turns toward Vaimok, Pieskehaure and Sulitjelma.",
        "Naturkartan has official Swedish segment pages for Tarrekaise-Kvikkjokk, Pieskehaure-Darreadno/Vaimok and Staddajakka-Pieskehaure/Mavas."
      ]
    },
    "resolvedVariantDecisions": [
      {
        "id": "abisko-gautelis-preferred-mainline",
        "decision": "Prefer the Abisko-Abiskojaure-Alesjaure-Salka-Duolbanjunni-Hukejaure-Norwegian border-Gautelis route for the app mainline.",
        "evidence": [
          "Naturkartan labels Abiskojaure-Alesjaure, Alesjaure-Salka, Duolbanjunni-Hukejaure and Norska gransen-Huvki as Kungsleden/Nordkalottleden or Nordkalottleden/Arctic Trail segments.",
          "UT.no Narvikfjellene says Nordkalottruta crosses from Hukejaure in Sweden to Gautelishytta and continues south in Norway.",
          "E1's Abiskojaure-Unna Allakas-Cunojavri-Caihnavaggi-Gautelis path should remain an alternate/planning seed because the E1 page itself says its overview only lists E1-identical or partly identical stages."
        ],
        "remainingWork": "Split the shared Kungsleden Sälka-Singi geometry at the Duolbanjunni/Nordkalottleden junction before runtime import."
      },
      {
        "id": "paltsa-gappo-rosta-policy",
        "decision": "Treat Treriksroset-Paltsa-Gappohytta-Rostahytta as the preferred official-source research model, but keep the E1 Goldahytta/Gappohytta evidence as a geometry cross-check until section geometry is harvested.",
        "evidence": [
          "Naturkartan has official Treriksroset-Paltsa and Gappo-Paltsa pages.",
          "STF describes Paltsa as lying along Nordkalottleden just south of Treriksroset.",
          "DNT Gappohytta and Rostahytta pages confirm the marked Gappo-Rosta route and current bridge warnings."
        ],
        "remainingWork": "Confirm final geometry through official linework before runtime import, especially around the Pältsa/Gappo/Rosta route alternatives and bridge-damage warnings."
      }
    ]
