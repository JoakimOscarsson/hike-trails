  "sourceContradictionsAndRisks": [
    {
      "topic": "Headline distance",
      "details": "Official/tourism sources vary between about 140 km, 150 km, 150-160 km, and 160 km. Per-stage distances sum to about 140 km when the named boat/access components are counted literally.",
      "impact": "Do not publish a normalized total until the GPX has been split and endpoint policy is decided.",
      "severity": "high"
    },
    {
      "topic": "Official stage order versus geometry grouping",
      "details": "STF uses 10 stages; Naturkartan groups the trail into longer records and sometimes stores geometry opposite STF direction. OSM relations are incomplete and use separate section numbering.",
      "impact": "Import must split/reverse route geometry section by section.",
      "severity": "high"
    },
    {
      "topic": "Stage 2 geometry",
      "details": "Official stage 2 is Gisuris-Låddejåhkå, but Naturkartan linework is split across bd58 and bd57 with a Kutjaure/Nordkalottleden access portion. OSM relation 19111627 may be the best cross-check.",
      "impact": "Needs targeted route-geometry research before normalization.",
      "severity": "high"
    },
    {
      "topic": "Current transport data",
      "details": "As of 2026-04-29 several access sources still expose 2025 timetables; 2026 summer bus/boat schedules were not consistently discoverable.",
      "impact": "Use transport stops and operators as access metadata; verify 2026 schedules close to import/publication.",
      "severity": "medium"
    },
    {
      "topic": "Current closures/conditions",
      "details": "Länsstyrelsen Aktuellt i fjällen had broad 2026 snow/ice warnings visible, but no section-specific Padjelantaleden closure was identified in Phase 1.",
      "impact": "Section research must still check currentness and bridge/boat pages.",
      "severity": "medium"
    },
    {
      "topic": "Hut/service currentness",
      "details": "BLT food and services can run out late in season and some notices are season-specific, for example Stáloluokta kiosk closure notes.",
      "impact": "Facility records should distinguish permanent huts/emergency phones from seasonal/commercial stock availability.",
      "severity": "medium"
    }
  ],
